{
  "name": "rocketseat-blog-ia-nodejs",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --watch src/index.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --env-file=.env.local --test tests/integration/*.test.js",
    "test:e2e": "node --env-file=.env.local --test tests/e2e/*.test.js",
    "lint": "oxlint --fix src tests",
    "format": "oxfmt src tests package.json",
    "format:check": "oxfmt --check src tests package.json",
    "docker:build": "docker build -t rocketseat-blog-ia:latest .",
    "env:setup": "cp .env.example .env.local",
    "local:setup": "npm run env:setup && npm run infra:up && npm run migrate:up",
    "migrate:up": "node --env-file=.env.local ./node_modules/postgrator-cli/index.js migrate",
    "migrate:down": "node --env-file=.env.local ./node_modules/postgrator-cli/index.js migrate 0",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mastra/core": "^0.20.0",
    "nanoid": "^5.1.5",
    "pg": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "postgrator-cli": "^9.1.0",
    "supertest": "^7.3.2"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs}": [
      "oxfmt --write",
      "oxlint --fix"
    ]
  },
  "allowScripts": {
    "lefthook@2.2.2": true
  }
}
